{
  "verification": {
    "checks": [
      {
        "name": "api_compile_check",
        "command": [
          "bash",
          "-c",
          "find chatbot/api -name '*.py' -exec python -m py_compile {} +"
        ]
      },
      {
        "name": "frontend_build",
        "command": [
          "npm",
          "run",
          "build",
          "--prefix",
          "react_ui"
        ]
      }
    ]
  }
}
