{
  "verification": {
    "checks": [
      {
        "name": "phase_d_py_compile",
        "command": [
          "python",
          "-m",
          "py_compile",
          "chatbot/api/config.py",
          "chatbot/perf/cache.py"
        ]
      },
      {
        "name": "phase_d_pytest",
        "command": [
          "python",
          "-m",
          "pytest",
          "tests/test_config_integration.py",
          "-q"
        ]
      },
      {
        "name": "phase_d_tsc_typecheck",
        "command": [
          "sh",
          "-c",
          "cd react_ui && npx tsc --noEmit"
        ]
      }
    ]
  }
}
