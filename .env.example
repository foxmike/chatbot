DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=google/gemma-4-31b-it
DEFAULT_PROVIDER=openrouter

# LLM Provider Routing Configuration
# LLM_PROVIDER can be: openrouter | sglang | vllm | ollama
LLM_PROVIDER=openrouter

# SGLang Configuration
SGLANG_BASE_URL=http://localhost:30000/v1
SGLANG_MODEL=
SGLANG_API_KEY=

# vLLM Configuration
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=
VLLM_API_KEY=

# Ollama Configuration
# Ollama exposes an OpenAI-compatible API on port 11434 by default.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
OLLAMA_API_KEY=
OLLAMA_NUM_CTX=8192

# Avatar (Faster-Whisper STT + Qwen3-TTS + AVTR-1). All optional; defaults are the known-good setup.
# AVATAR_QWEN_PATH=/home/mike/dev/tools/qwen
# AVATAR_AVTR_PATH=/home/mike/dev/tools/avtr-1
# AVATAR_QWEN_VOICE=A warm, natural young adult American woman with a relaxed, expressive conversational voice.
# AVATAR_ENDPOINT_SILENCE_MS=550
# AVATAR_BARGE_IN_ENABLED=true
# AVATAR_SYNC_BUFFER_MS=60
