DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=google/gemma-4-31b-it
DEFAULT_PROVIDER=openrouter

# LLM Provider Routing Configuration
# LLM_PROVIDER can be: openrouter | sglang | vllm | ollama
LLM_PROVIDER=openrouter

# SGLang Configuration
SGLANG_BASE_URL=http://localhost:30000/v1
SGLANG_MODEL=
SGLANG_API_KEY=

# vLLM Configuration
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=
VLLM_API_KEY=

# Ollama Configuration
# Ollama exposes an OpenAI-compatible API on port 11434 by default.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
OLLAMA_API_KEY=
OLLAMA_NUM_CTX=8192

# Avatar (Faster-Whisper STT + Qwen3-TTS VoiceDesign + AVTR-1)
AVATAR_QWEN_PATH=/home/mike/dev/tools/qwen
AVATAR_AVTR_PATH=/home/mike/dev/tools/avtr-1
AVATAR_QWEN_MODEL=Qwen3-TTS-12Hz-1.7B-VoiceDesign
AVATAR_QWEN_VOICE="A warm, natural young adult American woman with a relaxed, expressive conversational voice."
# Voice Library. AVATAR_QWEN_MODEL (VoiceDesign) creates voices; this Base model speaks every
# saved voice from its reference recording. AVATAR_QWEN_VOICE describes the built-in default
# voice, rendered once by: python -m chatbot.voices.init_default
AVATAR_QWEN_CLONE_MODEL=Qwen3-TTS-12Hz-1.7B-Base
AVATAR_DESIGN_IDLE_SECONDS=90
# Reference recordings of saved voices (private user data; never served as static files).
# VOICE_LIBRARY_DIR=/absolute/path/to/data/voices
VOICE_UPLOAD_MAX_BYTES=20971520
VOICE_REFERENCE_MIN_SECONDS=3
VOICE_REFERENCE_MAX_SECONDS=30
VOICE_PREVIEW_TTL_SECONDS=3600
AVATAR_STT_MODEL=base.en
AVATAR_STT_DEVICE=cpu
AVATAR_STT_COMPUTE_TYPE=int8
AVATAR_STT_LANGUAGE=en
AVATAR_ENDPOINT_SILENCE_MS=550
AVATAR_MAX_UTTERANCE_SECONDS=30
AVATAR_BARGE_IN_ENABLED=true
AVATAR_SYNC_BUFFER_MS=60
# Optional startup portrait; companions normally supply their stored portraits.
# AVATAR_PORTRAIT=
AVATAR_GPU_SAMPLING=false
AVATAR_WORKER_START_TIMEOUT=120
